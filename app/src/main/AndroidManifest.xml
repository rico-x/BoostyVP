<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Discover only the document/save handlers offered in our TV export chooser. -->
    <queries>
        <intent><action android:name="android.intent.action.CREATE_DOCUMENT" /><data android:mimeType="application/json" /></intent>
        <intent><action android:name="android.intent.action.OPEN_DOCUMENT" /><data android:mimeType="application/json" /></intent>
        <intent><action android:name="android.intent.action.GET_CONTENT" /><data android:mimeType="application/json" /></intent>
        <intent><action android:name="android.intent.action.SEND" /><data android:mimeType="application/json" /></intent>
    </queries>

    <!-- Declares this as a TV app: required for the Play Store TV channel and
         for the launcher to place it on the TV home screen. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- TVs have no touchscreen. Without this the app is filtered out of the
         TV store entirely. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".BoostyVPApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BoostyVP">

        <service android:name=".integration.TvChannelJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.updates"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
        <provider android:name=".integration.SettingsExportProvider" android:authorities="${applicationId}.exports"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/export_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BoostyVP">

            <!-- LEANBACK_LAUNCHER, not LAUNCHER: this is what puts the app on
                 the Android TV home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="boostyvp" android:host="post" />
                <data android:scheme="boostyvp" android:host="home" />
            </intent-filter>
        </activity>
    </application>
</manifest>
